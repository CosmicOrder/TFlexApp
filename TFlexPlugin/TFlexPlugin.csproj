<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>TFlexApp</RootNamespace>
		<AssemblyName>TFlexPlugin</AssemblyName>
		<PlatformTarget>x64</PlatformTarget>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="System" />
		<Using Include="System.IO" />
		<Using Include="System.Drawing" />
		<Using Include="System.Windows.Forms" />
		<Using Include="System.Collections.Generic" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="TFlexAPI">
			<HintPath>$(TFLEX_PATH)\TFlexAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="TFlexAPI3D">
			<HintPath>$(TFLEX_PATH)\TFlexAPI3D.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="TFlexCommandAPI">
			<HintPath>$(TFLEX_PATH)\TFlexCommandAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Model.cs" Link="Model.cs" />
		<Compile Include="..\Messages.cs" Link="Messages.cs" />
		<Compile Include="..\ICadFacade.cs" Link="ICadFacade.cs" />
		<Compile Include="..\IView.cs" Link="IView.cs" />
		<Compile Include="..\CadFacade.cs" Link="CadFacade.cs" />
		<Compile Include="..\Presenter.cs" Link="Presenter.cs" />
		<Compile Include="..\Form1.cs" Link="Form1.cs" />
		<Compile Include="..\Form1.Designer.cs" Link="Form1.Designer.cs" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\Form1.resx" Link="Form1.resx" />
	</ItemGroup>

	<ItemGroup>
		<None Include="TFlexPlugin.tfa">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
